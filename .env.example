# Copie este arquivo para ".env" e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser enviado para o GitHub (já está no .gitignore).
# ATENÇÃO: não coloque valores reais AQUI, este arquivo é público.

# Token gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui

# ID do chat que vai receber os alertas
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui
